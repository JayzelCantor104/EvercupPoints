# copy this to .env and put your own values
# don't commit the real .env

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=evercuppoints

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

PORT=3000

# frontend url (used for the link in the email)
APP_URL=http://localhost:5173

# email - optional, leave blank to turn it off
# for gmail use an app password, not your real password
# https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
